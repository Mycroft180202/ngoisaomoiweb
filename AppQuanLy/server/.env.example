# ==========================================
# CAU HINH HE THONG CORE
# ==========================================
PORT=3001
NODE_ENV=development
JWT_SECRET=travelops_super_secret_jwt_key_2026
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# DATABASE MONGODB
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/travelops

# ==========================================
# CAU HINH EMAIL NOTIFICATION (NODEMAILER)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ==========================================
# CAU HINH TELEGRAM BOT NOTIFICATION
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# CAU HINH ZALO OA (OFFICIAL ACCOUNT)
# ==========================================
ZALO_OA_ACCESS_TOKEN=your_zalo_access_token_here

# ==========================================
# CLOUDFLARE EMAIL ROUTING
# Token permissions: Email Routing Rules Read/Write, Email Routing Addresses Read/Write
# ==========================================
CLOUDFLARE_API_TOKEN=your_restricted_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_EMAIL_DOMAIN=newstartour.vn

# Goong REST API key cho Autocomplete va Place Detail
GOONG_API_KEY=your_goong_rest_api_key_here
WEBSITE_INTEGRATION_KEY=replace_with_a_long_random_secret
CMS_API_URL=https://api.newstartour.vn
CMS_CALLBACK_KEY=replace_with_a_separate_long_random_secret
